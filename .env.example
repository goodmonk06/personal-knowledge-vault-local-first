# Personal Knowledge Vault - Environment Configuration

# Demo Mode Settings (for development/testing)
# Set this to use a predictable demo password
DEMO_MODE=true
DEMO_PASSWORD=demo123456

# Database Configuration
# Default database location: ~/.local/share/personal-knowledge-vault/vault.db
# Override with custom path if needed
# DB_PATH=/custom/path/vault.db

# Development Settings
# Set to true to enable debug logging
DEBUG=false

# Note: This file is for documentation purposes.
# Tauri desktop apps don't typically use .env files.
# Configuration is managed through the app settings.
